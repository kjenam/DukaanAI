
# --- Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Comma-separated fallback chains. FAST answers billing commands (minimal thinking, ~2 s); MODEL does insights.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-latest
GEMINI_FAST_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest

# --- PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox > your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Sandbox PERSONAL account email (developer.paypal.com > Sandbox accounts).
# Used as the invoice recipient when a customer has no email, so you can pay invoices in the demo.
PAYPAL_DEMO_BUYER_EMAIL=

# Optional: a second sandbox BUSINESS account email that plays the supplier (payee of reorder payments).
# Leave empty to pay into your own app's business account.
SUPPLIER_PAYPAL_EMAIL=

# --- Shop settings
SHOP_NAME=Prajapat Kirana Store
SHOP_TZ=Asia/Kolkata
INR_PER_USD=88
DEADSTOCK_DAYS=30
ALLOW_RESET=1
